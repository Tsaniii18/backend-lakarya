# Database
# URL koneksi MySQL yang digunakan Prisma.
DATABASE_URL="mysql://user:password@localhost:3306/lakarya"

# Data awal
# Password untuk akun manager yang dibuat oleh seed utama.
SEED_MANAGER_PASSWORD="replace_with_a_strong_seed_password"

# Autentikasi
# Gunakan nilai acak yang panjang dan berbeda untuk setiap secret.
JWT_SECRET="replace_with_a_strong_jwt_secret"
RESET_PASSWORD_SECRET="replace_with_a_different_reset_secret"

# Aplikasi
# Origin frontend yang diizinkan oleh CORS dan digunakan pada tautan reset password.
FRONTEND_URL="http://localhost:5173"
# Port HTTP backend. Platform hosting dapat mengisi nilai ini secara otomatis.
PORT="3000"

# Email (Resend)
# Endpoint API ini umumnya tidak perlu diubah.
RESEND_API_URL="https://api.resend.com/emails"
# API key Resend dengan izin untuk mengirim email.
RESEND_API_KEY="re_your_resend_api_key"
# Domain alamat pengirim harus sama persis dengan domain yang terverifikasi di Resend.
RESEND_FROM_EMAIL="LaKarya <noreply@your-verified-domain.example>"

# Penyimpanan lampiran (Cloudflare R2)
R2_ACCOUNT_ID="cloudflare_account_id"
R2_ACCESS_KEY_ID="r2_access_key_id"
R2_SECRET_ACCESS_KEY="r2_secret_access_key"
R2_BUCKET="bucket_name"
# Base URL publik untuk mengakses file yang sudah diunggah.
R2_PUBLIC_URL="https://assets.example.com"
